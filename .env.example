# Copy these names into Vercel → Project → Settings → Environment Variables.
# Never commit real values.

# Cloudbeds (Ko-Sa property only)
CLOUDBEDS_API_KEY=
CLOUDBEDS_PROPERTY_ID=
# Set to true only once the key has the write scopes. Without it the site never writes to Cloudbeds.
CLOUDBEDS_ALLOW_WRITE=
# Payment type used when recording Paystack payments in Cloudbeds (see /api/cloudbeds/status). Default: ebanking
CLOUDBEDS_PAYMENT_TYPE=

# Paystack (pay now). Secret key from Paystack → Settings → API Keys & Webhooks.
PAYSTACK_SECRET_KEY=
# Optional: let guests reserve without paying first. Leave empty unless you really want it.
BOOKING_ALLOW_PAY_LATER=

# Who gets the "new website booking" emails (defaults to info@ko-sa.com). Needs RESEND_API_KEY to send.
BOOKINGS_NOTIFY_EMAIL=
