# Copy these names into Vercel → Project → Settings → Environment Variables.
# Never commit real values.

# Cloudbeds, read-only key for the Ko-Sa property. Live prices and rooms left.
CLOUDBEDS_API_KEY=
CLOUDBEDS_PROPERTY_ID=

# Guests book and pay their 30% deposit on the Cloudbeds booking page, so nothing
# below is needed. Leave these empty; setting both would switch on booking on the
# KoSa site itself, which is not how Ko-Sa works today.
# CLOUDBEDS_ALLOW_WRITE=
# PAYSTACK_SECRET_KEY=
